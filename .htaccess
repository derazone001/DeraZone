# ============================================================
# DERA ZONE - Apache / cPanel / Web Server Configuration
# ============================================================

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Universal API Router for cPanel & Hostinger (Native PHP, zero Node.js dependency)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php?endpoint=$1 [QSA,L]

  # 2. Route /admin and /admin/ cleanly to admin.html
  RewriteRule ^admin/?$ admin.html [L,QSA]

  # 3. Clean URLs: Redirect /index.html to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html(?:\s|\?|$) [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 4. Clean URLs: 301 Redirect direct requests for *.html -> extensionless URL
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^.?\s]+)\.html(?:\s|\?|$) [NC]
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteRule ^ %1 [R=301,L,QSA]

  # 5. Clean URLs: Internally map /page to /page.html if page.html exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L,QSA]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"

  # Prevent aggressive caching of HTML & CSS during active development
  <FilesMatch "\.(html|htm|css|js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# MIME types
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/font-woff2 .woff2
  AddType application/json .json
</IfModule>
